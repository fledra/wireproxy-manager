{
  "name": "wireproxy-manager",
  "description": "A simple GUI for managing multiple wireproxy instances",
  "version": "0.1.1",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "author": "Baran D. <baran@fledra.dev> (https://fledra.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fledra/wireproxy-manager.git"
  },
  "bugs": {
    "url": "https://github.com/fledra/wireproxy-manager/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:prepare": "tauri icon public/icon.svg && node scripts/getWireproxy.js",
    "tauri:icon": "tauri icon public/icon.svg",
    "tauri:sidecar": "node scripts/getWireproxy.js",
    "bump": "changelogen --bump",
    "bump:release": "changelogen --release"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "nanoid": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fledra/eslint-config": "^3.0.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "tar": "^7.5.22",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12"
  },
  "changelog": {
    "output": false,
    "templates": {
      "commitMessage": "chore: release v{{newVersion}}"
    }
  }
}
