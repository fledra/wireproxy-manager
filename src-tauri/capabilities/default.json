{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "fs:default",
    "fs:read-dirs",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/configs" },
        { "path": "$APPDATA/configs/*" },
        { "path": "$APPDATA/wireproxy-manager.config.json" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "sidecar": true,
          "name": "binaries/wireproxy",
          "args": [
            "-c",
            {
              "validator": ".*[\\/]configs[\\/]\\S{21}\\.conf"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "sidecar": true,
          "name": "binaries/wireproxy"
        }
      ]
    }
  ]
}
