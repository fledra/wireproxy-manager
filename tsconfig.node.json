{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    "paths": {
      "#build/ui": [
        "./node_modules/.nuxt-ui/ui"
      ]
    },

    "types": ["node", "tar"]
  },
  "include": ["vite.config.ts"]
}
